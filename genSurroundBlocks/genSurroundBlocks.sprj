<?xml version="1.0"?>
<project version="2">
	<pipeline>
		<pass name="Cells" type="shader" active="true" patchverts="1">
			<shader type="vs" path="shaders\CellsVS.hlsl" entry="main" />
			<shader type="ps" path="shaders\CellsPS.hlsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Normal" semantic="NORMAL" />
				<item value="Texcoord" semantic="TEXCOORD0" />
			</inputlayout>
			<rendertexture name="texDots" />
			<items>
				<item name="QuadCells" type="geometry">
					<type>ScreenQuadNDC</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
			</items>
			<itemvalues />
			<variables>
				<variable type="float2" name="uResolution" system="ViewportSize" />
				<variable type="float" name="uTime" system="Time" />
				<variable type="float" name="uR">
					<row>
						<value>0.419999987</value>
					</row>
				</variable>
			</variables>
			<macros />
		</pass>
		<pass name="Main" type="shader" active="true" patchverts="1">
			<shader type="vs" path="shaders\MainVS.hlsl" entry="main" />
			<shader type="ps" path="shaders\MainPS.hlsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Normal" semantic="NORMAL" />
				<item value="Texcoord" semantic="TEXCOORD0" />
			</inputlayout>
			<rendertexture />
			<items>
				<item name="Quad" type="geometry">
					<type>ScreenQuadNDC</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
			</items>
			<itemvalues />
			<variables>
				<variable type="float2" name="uResolution" system="ViewportSize" />
				<variable type="float" name="uTime" system="Time" />
				<variable type="float" name="uThreshold">
					<row>
						<value>0.400000006</value>
					</row>
				</variable>
				<variable type="float" name="uP">
					<row>
						<value>2.3499999</value>
					</row>
				</variable>
			</variables>
			<macros />
		</pass>
	</pipeline>
	<objects>
		<object type="rendertexture" name="texDots" format="R8" rsize="0.062500,0.062500" clear="true">
			<bind slot="0" name="Main" />
		</object>
		<object type="texture" path="textures\blocks.png" vflip="false" min_filter="Linear" mag_filter="Nearest" wrap_s="Repeat" wrap_t="Repeat">
			<bind slot="2" name="Main" />
		</object>
		<object type="texture" path="textures\noisekit.png" vflip="false" min_filter="Linear" mag_filter="Linear" wrap_s="Repeat" wrap_t="Repeat">
			<bind slot="1" name="Main" />
		</object>
	</objects>
	<cameras />
	<settings>
		<entry type="property" name="Cells" item="pipe" />
		<entry type="file" name="Cells" shader="vs" />
		<entry type="file" name="Cells" shader="ps" />
		<entry type="pinned" name="uR" owner="Cells" />
		<entry type="pinned" name="uP" owner="Main" />
		<entry type="camera" fp="false">
			<distance>4</distance>
			<pitch>28</pitch>
			<yaw>317</yaw>
			<roll>360</roll>
		</entry>
		<entry type="clearcolor" r="0" g="0" b="0" a="0" />
		<entry type="usealpha" val="false" />
	</settings>
	<plugindata />
</project>
